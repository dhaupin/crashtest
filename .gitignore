node_modules/
coverage/
*.tgz
.npm/
.DS_Store
docs/_site/
packs/local/

# The sidecar cut stamp is the ONE churn-by-design surface (see AGENTS.md's
# determinism ritual): the committed ledger + report are byte-stable, the
# stamp moves with every run.
labs/run-meta.json

# Environment files never travel with the repo (defense-in-depth: the CLI
# itself reads no .env secrets - they only exist in maintainer sandboxes).
.env
.env.*
!.env.example

# Web build artifacts (web/.gitignore repeats these for its own tooling)
web/node_modules/
web/dist/
web/.prestruct/

# The family-status@1 emitter's output (regenerated on every web build -
# see web/scripts/build-status.mjs; committing it would be the stale-copy
# drift class the family kills everywhere else)
web/public/status.json

# Docs build products (belt-and-suspenders, crashtest#42: an accidental
# in-tree Jekyll build taints nothing; CI builds from a scratch copy)
docs/.bundle/
docs/vendor/
docs/_site/
docs/Gemfile.lock
